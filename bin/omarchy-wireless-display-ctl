#!/bin/bash

# omarchy:summary=Control CLI for the Wireless Display panel (Miracast: waycast; AirPlay: doubletake)
# omarchy:group=wireless-display
#
# One state file, two backends:
#
#   miracast  waycast   -- Wi-Fi Direct. A long-lived, blocking, single-session
#                          process launched per connection and tailed for its
#                          JSONL event stream.
#   airplay   doubletake -- mDNS over the existing network. A daemon that holds
#                          every stream itself; this script asks it for status
#                          and folds the answer in. No tailer, no pid tracking.
#
# The two differ in what they can do at once, and that asymmetry is the whole
# reason this file is shaped the way it is:
#
#   - At most ONE Miracast session. waycast owns the Wi-Fi P2P interface and,
#     in extend mode, an edit to ~/.config/hypr/xdph.conf; two would fight over
#     both. Connecting a second Miracast display is a switch, not an error.
#   - Any number of AirPlay sessions. doubletake's daemon groups them by codec
#     and canvas and fans one capture out to all of them.
#   - The two can run together: they use different radios' worth of the same
#     card but not the same interface, and only waycast touches the portal
#     config.
#
# Display ids are namespaced by protocol -- "miracast:<mac>", "airplay:<ip>" --
# so the panel can hand one back without knowing which backend owns it, and the
# two lists can never collide. Every entry also carries `address`, the bare
# identifier its own backend wants.
#
# Known limitations:
#   - doubletake mirrors only. There is no AirPlay extend: the panel keeps the
#     switch on AirPlay rows but the mode it reports is always "mirror".
#   - A receiver that wants a PIN or password is reported as an error naming
#     the device. Pair it once from a terminal (`doubletake -target <ip>
#     -pair`) and its credentials are reused from then on; there is no PIN
#     entry in the panel yet.
#   - `waycast daemon --sink X` re-discovers internally before connecting even
#     though the scan already found X, so Miracast connects take a few extra
#     seconds. waycast has no "connect directly" mode.
#   - Neither backend reports signal strength; peers always carry signal=null.
#   - If a Miracast disconnect has to fall back to SIGKILL, waycast's
#     Drop-based cleanup (headless output removal, xdph.conf restore) does not
#     run -- SIGKILL skips Rust Drop entirely.

set -uo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-wireless-display"
STATE_FILE="$STATE_DIR/state.json"
DAEMON_PID_FILE="$STATE_DIR/daemon.pid"
TAILER_PID_FILE="$STATE_DIR/tailer.pid"
SCAN_PID_FILE="$STATE_DIR/scan.pid"
AIRPLAY_SCAN_PID_FILE="$STATE_DIR/airplay-scan.pid"
DAEMON_LOG="$STATE_DIR/daemon.jsonl"
DAEMON_ERR_LOG="$STATE_DIR/daemon.err"
AIRPLAY_DAEMON_LOG="$STATE_DIR/airplay-daemon.log"
AIRPLAY_DAEMON_PID_FILE="$STATE_DIR/airplay-daemon.pid"

WAYCAST="${OMARCHY_WIRELESS_DISPLAY_WAYCAST_BIN:-waycast}"
DOUBLETAKE="${OMARCHY_WIRELESS_DISPLAY_DOUBLETAKE_BIN:-doubletake}"
DOUBLETAKE_CTL="${OMARCHY_WIRELESS_DISPLAY_DOUBLETAKE_CTL_BIN:-doubletake-ctl}"
AIRPLAY_SOCKET="${XDG_RUNTIME_DIR:-/tmp}/doubletake.sock"
DISCOVER_TIMEOUT="${OMARCHY_WIRELESS_DISPLAY_DISCOVER_TIMEOUT:-8}"
DISCONNECT_GRACE_SECONDS="${OMARCHY_WIRELESS_DISPLAY_DISCONNECT_GRACE_SECONDS:-10}"

# waycast's own --interface default is "wlan0", the old kernel-numbered
# naming; most current systems (predictable network interface naming) use
# something like "wlp0s20f3" instead, so autodetect the real managed Wi-Fi
# interface rather than trust that default. `OMARCHY_WIRELESS_DISPLAY_INTERFACE`
# overrides it outright.
detect_wifi_interface() {
  iw dev 2>/dev/null | awk '/^[[:space:]]*Interface/{iface=$2} /type managed/{print iface; exit}'
}
WIFI_INTERFACE="${OMARCHY_WIRELESS_DISPLAY_INTERFACE:-$(detect_wifi_interface)}"
WIFI_INTERFACE="${WIFI_INTERFACE:-wlan0}"

mkdir -p "$STATE_DIR"

# `pending` is a list for the same reason `connected` is: several AirPlay
# receivers can be coming up at once. It holds at most one Miracast entry.
# Each entry carries its own `mode`, because neither backend echoes back which
# mode it was asked for.
EMPTY_STATE='{"status":"idle","error":"","scanning":false,"pending":[],"connected":[],"peers":[]}'

STATE_LOCK="$STATE_DIR/state.lock"

# This script re-invokes itself to apply daemon events, so it needs its own
# path rather than relying on being on PATH.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

# `status` is derived, never assigned. It used to be set by hand at every
# mutation site, which is workable with one session and not with several: a
# connect landing while another display was already streaming had to know
# which of "pairing" and "streaming" outranked the other. Deriving it from the
# lists that actually changed leaves one rule in one place.
#
# Order matters. Discovery wins because it is the only state the user started
# deliberately and can end; a connection in flight outranks a settled one,
# since that is the thing still worth watching; an error only shows once
# nothing is happening, so a failed connect does not mask a working display.
RESTATUS='
  def restatus:
    .status = (
      if .scanning then "discovering"
      elif (.pending | length) > 0 then
        (if any(.pending[]; .state == "negotiating") then "negotiating" else "pairing" end)
      elif (.connected | length) > 0 then "streaming"
      elif .error != "" then "error"
      else "idle" end
    );
'

read_state() {
  if [[ -f $STATE_FILE ]]; then
    cat "$STATE_FILE"
  else
    printf '%s' "$EMPTY_STATE"
  fi
}

# Atomic: the panel polls this file twice a second, and a plain redirect
# truncates before it writes, so a poll landing in that window reads an empty
# file and parses as the default state -- a connected display flickering out
# of the UI for one frame.
write_state() {
  local tmp="$STATE_FILE.$$"
  printf '%s' "$1" >"$tmp" && mv -f "$tmp" "$STATE_FILE"
}

# Read-modify-write under a lock, with `status` re-derived afterwards.
#
# Every mutation goes through here. Without it, concurrent writers each read
# the file, transform their own snapshot and write it back, so whichever
# finishes last silently discards the other's change. That is not theoretical:
# it is what left `status` at "streaming" while `pending` was never moved into
# `connected`, so the panel showed a session it could not offer to disconnect.
#
# jq arguments are passed through, e.g.
#   update_state '.error=$e' --arg e "..."
update_state() {
  local program=$1; shift
  local fd
  exec {fd}>>"$STATE_LOCK"
  if flock -w 5 "$fd"; then
    local current updated
    current=$(read_state)
    if updated=$(jq "$@" "$RESTATUS ($program) | restatus" <<<"$current" 2>/dev/null) \
      && [[ -n $updated ]]; then
      write_state "$updated"
    else
      echo "state update failed, leaving state untouched: $program" >&2
    fi
  else
    echo "timed out waiting for the state lock; skipping update" >&2
  fi
  exec {fd}>&-
}

pid_alive() {
  [[ -n ${1:-} ]] && kill -0 "$1" 2>/dev/null
}

kill_tracked() {
  local pidfile=$1 signal=${2:-TERM}
  [[ -f $pidfile ]] || return 0
  local pid
  pid=$(cat "$pidfile")
  pid_alive "$pid" && kill "-$signal" "$pid" 2>/dev/null
  rm -f "$pidfile"
}

# The tailer is a process group leader, so signal the whole group -- the
# negative pid -- or the `tail` inside it survives.
kill_tailer() {
  [[ -f $TAILER_PID_FILE ]] || return 0
  local pid
  pid=$(cat "$TAILER_PID_FILE")
  if [[ -n $pid ]]; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  fi
  rm -f "$TAILER_PID_FILE"
}

# --- identity ----------------------------------------------------------

protocol_of() { printf '%s' "${1%%:*}"; }

# Everything after the first colon. A Miracast address is itself full of
# colons, so this cannot be a plain field split.
address_of() { printf '%s' "${1#*:}"; }

# --- shared predicates -------------------------------------------------

# Something owns a backend when it is connected or being connected.
#
# This is the single rule for "is something in progress", derived from the
# same two fields the panel reads. It replaces a `status != idle` test, which
# was a third, subtly different rule: it also refused while status was
# "error", so pressing rescan after a failed connect silently did nothing
# while the panel -- which asks whether anything is connected, not what the
# status string says -- offered the button as available.
session_active() {
  local state=${1:-$(read_state)}
  [[ $(jq -r 'if ((.pending | length) > 0) or ((.connected | length) > 0) then "yes" else "no" end' \
    <<<"$state") == yes ]]
}

has_protocol_session() {
  local proto=$1 state=${2:-$(read_state)}
  [[ $(jq -r --arg p "$proto" '
        if any((.pending + .connected)[]; .protocol == $p) then "yes" else "no" end
      ' <<<"$state") == yes ]]
}

# --- AirPlay: doubletake daemon ----------------------------------------

airplay_available() { command -v "$DOUBLETAKE_CTL" >/dev/null 2>&1; }

airplay_daemon_running() {
  [[ -S $AIRPLAY_SOCKET ]] && "$DOUBLETAKE_CTL" status >/dev/null 2>&1
}

# doubletake's daemon runs continuous mDNS discovery, so it is started only
# when the panel actually wants AirPlay -- on a scan or a connect -- and shut
# down again when nothing is using it. Leaving it up would put a permanent
# mDNS conversation on the network for a plugin the user may not have opened
# in days.
start_airplay_daemon() {
  airplay_available || return 1
  airplay_daemon_running && return 0
  command -v "$DOUBLETAKE" >/dev/null 2>&1 || return 1

  setsid "$DOUBLETAKE" -daemonize >>"$AIRPLAY_DAEMON_LOG" 2>&1 &
  local pid=$!
  disown

  # The socket appears before the daemon answers on it; wait for an answer.
  local waited=0
  while (( waited < 50 )); do
    if airplay_daemon_running; then
      echo "$pid" >"$AIRPLAY_DAEMON_PID_FILE"
      return 0
    fi
    sleep 0.1
    (( waited++ ))
  done
  return 1
}

# Only a daemon this script started is stopped. One the user is running
# themselves -- for the CLI, or for another client -- is left alone: it was
# not ours to take down, and its streams are not ours to end.
stop_airplay_daemon() {
  [[ -f $AIRPLAY_DAEMON_PID_FILE ]] || return 0
  has_protocol_session airplay && return 0

  local pid
  pid=$(cat "$AIRPLAY_DAEMON_PID_FILE")
  rm -f "$AIRPLAY_DAEMON_PID_FILE"
  pid_alive "$pid" || return 0
  kill -TERM "$pid" 2>/dev/null

  # Wait for it to be gone. SIGTERM returns at once, and a dying daemon goes
  # on answering its socket for a moment -- long enough for the next
  # start_airplay_daemon to decide one was already running, skip starting a
  # replacement, and hand a connect a backend that then exited underneath it.
  local waited=0
  while pid_alive "$pid" && (( waited < 50 )); do
    sleep 0.1
    (( waited++ ))
  done
  pid_alive "$pid" && kill -KILL "$pid" 2>/dev/null
}

# Folds `doubletake-ctl status` into our state.
#
# doubletake's daemon is the authority on its own streams, so this is a
# reconciliation rather than an event feed: every AirPlay entry we hold is
# checked against the daemon's list and made to agree with it. That covers
# the cases a per-event stream would each need separate handling for -- a
# stream that came up, one that failed, one that ended on the receiver's side,
# and one started by some other doubletake client entirely.
sync_airplay() {
  local state streams
  state=$(read_state)

  # Nothing of ours to reconcile and no daemon to ask: leave the state alone
  # rather than start a daemon just to be told there is nothing.
  if ! airplay_daemon_running; then
    has_protocol_session airplay "$state" || return 0

    # Two different failures, and saying "the session ended" for both sent a
    # bare install chasing a stream that never existed. The binary being
    # absent is a setup problem; the daemon being absent while the binary is
    # there is a crash.
    local reason="The AirPlay session ended unexpectedly"
    airplay_available || reason="AirPlay is unavailable: doubletake is not installed"

    update_state '
        .pending = (.pending | map(select(.protocol != "airplay")))
        | .connected = (.connected | map(select(.protocol != "airplay")))
        | .error = $err
      ' --arg err "$reason"
    return 0
  fi

  streams=$("$DOUBLETAKE_CTL" status 2>/dev/null | jq -c '[.streams[]? | {
      address: .device_ip,
      name: (.device // .device_ip),
      state: .state,
      credential: (.credential_kind // "")
    }]' 2>/dev/null)
  [[ -z $streams || $streams == null ]] && streams='[]'

  # `live` is every AirPlay display the daemon says it has, rebuilt from
  # scratch each time. A stream we never started is adopted rather than
  # ignored: it is on the user's screen, so the panel should be able to say so
  # and to end it.
  update_state '
      ($streams | map(. + {
          id: ("airplay:" + .address),
          protocol: "airplay",
          mode: "mirror",
          output: ""
        })) as $live
      | ($live | map(select(.state == "streaming"))) as $up
      | ($live | map(select(.state != "streaming"))) as $coming
      | ($live | map(select(.credential != "")) | map(.name) | join(", ")) as $waiting
      | .connected = ((.connected | map(select(.protocol != "airplay")))
          + ($up | map({id, name, protocol, address, mode, output})))
      | .pending = ((.pending | map(select(.protocol != "airplay")))
          + ($coming | map({id, name, protocol, address, mode, output, state: "pairing"})))
      | .peers = (.peers | map(
          if .protocol == "airplay" then
            .address as $a
            | .state = (if any($up[]; .address == $a) then "connected" else "available" end)
          else . end))
      | if $waiting != "" then
          .error = ($waiting + " is asking for a PIN or password. Pair it once from a terminal: doubletake -target <ip> -pair")
        else . end
    ' --argjson streams "$streams"

  # A receiver waiting for a credential waits forever as far as this script is
  # concerned: there is no PIN entry in the panel, so nothing will ever answer
  # it. Left alone it would sit in `pending` for good, which reads as "still
  # connecting" and blocks every rescan. End it instead -- the error set above
  # says what happened and what to do about it.
  local addr
  while IFS= read -r addr; do
    [[ -n $addr ]] && "$DOUBLETAKE_CTL" disconnect "$addr" >/dev/null 2>&1
  done < <(jq -r '.[] | select(.credential != "") | .address' <<<"$streams")
}

# --- state -------------------------------------------------------------

cmd_state() {
  reconcile_miracast
  sync_airplay
  read_state
}

# A Miracast session whose daemon has died leaves the state claiming a
# connected display forever: SIGKILL skips waycast's teardown, so no "ended"
# event is ever written, and the panel goes on offering a disconnect button
# for a session that no longer exists. Notice and clear it, so the UI recovers
# by itself rather than needing a manual disconnect.
#
# Only Miracast entries are touched. AirPlay has its own authority to ask
# (sync_airplay) and its streams outlive any process this script tracks.
reconcile_miracast() {
  local state
  state=$(read_state)
  has_protocol_session miracast "$state" || return 0

  if [[ -f $DAEMON_PID_FILE ]]; then
    # A live daemon means the state is real, whatever it says.
    pid_alive "$(cat "$DAEMON_PID_FILE")" && return 0
  elif [[ $(jq -r 'any(.pending[]; .protocol == "miracast")' <<<"$state") == true ]]; then
    # No pid file yet, but a connect is in flight -- cmd_connect writes the
    # pending display before it has a pid to record. Do not race it.
    return 0
  fi

  echo "the Miracast session's daemon is gone; resetting it" >&2
  kill_tailer
  update_state '
      .pending = (.pending | map(select(.protocol != "miracast")))
      | .connected = (.connected | map(select(.protocol != "miracast")))
      | .peers = (.peers | map(if .protocol == "miracast" then .state = "available" else . end))
      | .error = "The display session ended unexpectedly"
    '
  rm -f "$DAEMON_PID_FILE"
}

# --- discovery ---------------------------------------------------------

# Both backends are scanned at once and each lands its own slice of `peers`
# when it finishes, so the Wi-Fi Direct scan -- which takes seconds of radio
# time -- never holds up the AirPlay list, which mDNS usually has within one.
cmd_scan_start() {
  # Discovery contends with an active session for the Wi-Fi radio, so it
  # yields to one -- but anything else is a valid moment to look again. This
  # now protects AirPlay too: a Wi-Fi Direct scan interrupts the very network
  # an AirPlay stream is riding on.
  session_active && return 0

  kill_tracked "$SCAN_PID_FILE" TERM
  kill_tracked "$AIRPLAY_SCAN_PID_FILE" TERM

  # Starting a scan discards what the last one found and any error it left
  # behind. Keeping them meant a rescan showed the previous list, and a
  # previous failure's message, while the new scan was still running -- with
  # nothing to say which was current.
  update_state '.scanning = true | .error = "" | .peers = [] | .pending = []'

  (
    echo $BASHPID >"$SCAN_PID_FILE"
    result=$("$WAYCAST" --json --interface "$WIFI_INTERFACE" discover --timeout "$DISCOVER_TIMEOUT" 2>/dev/null)
    peers=$(jq -c '[.devices[]? | {
        id: ("miracast:" + .address),
        address: .address,
        name: (.name // .address),
        protocol: "miracast",
        signal: null,
        state: "available"
      }]' <<<"$result" 2>/dev/null)
    [[ -z $peers || $peers == null ]] && peers='[]'
    land_peers miracast "$peers"
    rm -f "$SCAN_PID_FILE"
    finish_scan
  ) &
  disown

  (
    echo $BASHPID >"$AIRPLAY_SCAN_PID_FILE"
    if start_airplay_daemon; then
      # `discover` returns whatever the daemon's continuous mDNS browse has
      # found so far, so this polls rather than asking once: a daemon started
      # by this very call has an empty cache, and how long the first responses
      # take is the network's business, not ours. A single ask plus a fixed
      # 1.5s wait reported an empty network against a receiver that was
      # plainly there.
      #
      # It runs for the same window the Wi-Fi Direct scan does, and lands each
      # time the list changes, so receivers appear as they answer instead of
      # all at the end.
      last='[]'
      deadline=$(( SECONDS + DISCOVER_TIMEOUT ))
      while (( SECONDS < deadline )); do
        result=$("$DOUBLETAKE_CTL" discover 2>/dev/null)
        peers=$(jq -c '[.devices[]? | {
            id: ("airplay:" + .ip),
            address: .ip,
            name: (.name // .ip),
            protocol: "airplay",
            signal: null,
            state: "available"
          }]' <<<"$result" 2>/dev/null)
        [[ -z $peers || $peers == null ]] && peers='[]'
        if [[ $peers != "$last" ]]; then
          land_peers airplay "$peers"
          last=$peers
        fi
        sleep 0.5
      done
    else
      land_peers airplay '[]'
    fi
    rm -f "$AIRPLAY_SCAN_PID_FILE"
    finish_scan
  ) &
  disown
}

# One protocol's results replace that protocol's peers and nothing else, so
# the two scanners can finish in either order without overwriting each other.
land_peers() {
  local proto=$1 peers=$2
  update_state '
      if .scanning then
        .peers = ((.peers | map(select(.protocol != $proto))) + $peers
          | sort_by(.protocol, (.name | ascii_downcase)))
      else . end
    ' --arg proto "$proto" --argjson peers "$peers"
}

# Discovery is over once neither scanner is still running.
finish_scan() {
  [[ -f $SCAN_PID_FILE || -f $AIRPLAY_SCAN_PID_FILE ]] && return 0
  update_state '.scanning = false'
}

# Ends discovery and nothing else. A connect wants exactly this: it is done
# looking, but the AirPlay daemon it is about to talk to must stay up.
stop_scanners() {
  kill_tracked "$SCAN_PID_FILE" TERM
  kill_tracked "$AIRPLAY_SCAN_PID_FILE" TERM
  # Only a discovery session's own results are dropped; a connected display
  # must survive the panel being closed.
  update_state 'if .scanning then .scanning = false | .peers = [] else . end'
}

# The panel closing: stop looking, and release a backend nothing is using.
cmd_scan_stop() {
  stop_scanners
  stop_airplay_daemon
}

# --- Miracast: waycast events ------------------------------------------

# Folds one line of `waycast --json daemon` output (see that fork's
# crates/cli daemon_event_json) into the state file. Anything not
# recognized is ignored rather than erroring -- forward-compatible with
# waycast emitting event kinds this wrapper doesn't know about yet.
#
# Every program below addresses the Miracast entry specifically. waycast runs
# one session, so "the pending Miracast display" is unambiguous, but it is no
# longer "the pending display": an AirPlay receiver may be coming up beside it.
apply_event() {
  local line=$1
  local event
  event=$(jq -r '.event // empty' <<<"$line" 2>/dev/null)
  [[ -z $event ]] && return 0

  case "$event" in
    started)
      update_state '.pending = (.pending | map(if .protocol == "miracast" then .state = "pairing" else . end))'
      ;;
    connected|negotiated)
      update_state '.pending = (.pending | map(if .protocol == "miracast" then .state = "negotiating" else . end))'
      ;;
    virtual_output_created)
      local output_name
      output_name=$(jq -r '.name // empty' <<<"$line")
      # Mirroring creates no virtual output, so this never fires for it and
      # the display's `output` stays empty -- which is correct, not missing.
      [[ -n $output_name ]] && update_state \
        '.pending = (.pending | map(if .protocol == "miracast" then .output = $out else . end))' \
        --arg out "$output_name"
      ;;
    streaming_started)
      # The in-flight display becomes a connected one. Its mode came from the
      # connect call, not from waycast, which is why we carried it here.
      update_state '
          (.pending | map(select(.protocol == "miracast"))) as $up
          | .connected += ($up | map(del(.state)))
          | .pending = (.pending | map(select(.protocol != "miracast")))
          | .peers = (.peers | map(
              .id as $i
              | if any($up[]; .id == $i) then .state = "connected" else . end))
        '
      ;;
    error)
      local message
      message=$(jq -r '.message // "Connection failed"' <<<"$line")
      update_state '
          .error = $err
          | .pending = (.pending | map(select(.protocol != "miracast")))
        ' --arg err "$message"
      ;;
    ended)
      # A prior "error" event already told the story; don't clobber it with a
      # bare reset once the (now-exiting) daemon process catches up.
      update_state '
          .pending = (.pending | map(select(.protocol != "miracast")))
          | .connected = (.connected | map(select(.protocol != "miracast")))
          | .peers = (.peers | map(if .protocol == "miracast" then .state = "available" else . end))
        '
      rm -f "$DAEMON_PID_FILE"
      ;;
  esac
}

# --- connect / disconnect ----------------------------------------------

cmd_connect() {
  local display_id=${1:?display id required}
  local mode=${2:-mirror}

  case "$mode" in
    extend|mirror) ;;
    *) echo "unknown mode '$mode' (expected 'extend' or 'mirror')" >&2; return 64 ;;
  esac

  local current peer protocol address
  current=$(read_state)
  peer=$(jq --arg id "$display_id" '[.peers[] | select(.id == $id)][0]' <<<"$current")
  if [[ $peer == null ]]; then
    update_state '.error = $err' --arg err "Unknown display $display_id"
    return 1
  fi

  # One connect at a time, whichever backend. Both reach for the screencast
  # portal while they set up, and waycast arms a one-shot picker override for
  # its headless output moments before its own request -- a second connect
  # landing in that window can consume the override and be handed waycast's
  # output instead of the screen it asked for.
  if [[ $(jq -r '(.pending | length) > 0' <<<"$current") == true ]]; then
    echo "another display is still connecting" >&2
    return 1
  fi

  protocol=$(protocol_of "$display_id")
  address=$(address_of "$display_id")

  case "$protocol" in
    miracast) connect_miracast "$peer" "$address" "$mode" ;;
    # doubletake has no extend mode. The panel still shows the switch on
    # AirPlay rows -- one control in one place beats a row that is a
    # different shape per protocol -- so the mode is dropped here rather
    # than refused, and what the state reports is what actually happened.
    airplay)  connect_airplay "$peer" "$address" ;;
    *) echo "unknown protocol '$protocol'" >&2; return 64 ;;
  esac
}

connect_miracast() {
  local peer=$1 address=$2 mode=$3

  # Still one Miracast session at a time. But pairing with a different display
  # is a switch, not an error: end the current session first and carry on. The
  # peer was captured by the caller, before this teardown, precisely so the
  # discovered list can be preserved across it.
  if has_protocol_session miracast; then
    local previous
    previous=$(jq -r '[.connected[] | select(.protocol == "miracast") | .name] | join(", ")' <<<"$(read_state)")
    [[ -n $previous ]] && echo "switching away from $previous" >&2
    stop_miracast_session
    update_state '
        .connected = (.connected | map(select(.protocol != "miracast")))
        | .pending = (.pending | map(select(.protocol != "miracast")))
        | .error = ""
        | .peers = (.peers | map(if .protocol == "miracast" then .state = "available" else . end))
      '
  fi

  stop_scanners

  update_state '
      .error = ""
      | .pending += [$peer + {mode: $mode, output: "", state: "pairing"}]
    ' --argjson peer "$peer" --arg mode "$mode"

  # --extend creates a headless output and streams that. Without it waycast
  # mirrors an existing output, which it picks through the desktop portal --
  # so mirroring shows the portal's screen-share dialog, because nothing
  # arms waycast's one-shot picker override outside extend mode.
  local -a mode_args=()
  [[ $mode == extend ]] && mode_args+=(--extend)

  # Belt and braces against a tailer that outlived its process group.
  kill_tailer
  pkill -f "tail -n \\+1 -F $DAEMON_LOG" 2>/dev/null || true

  : >"$DAEMON_LOG"
  : >"$DAEMON_ERR_LOG"
  setsid "$WAYCAST" --json --interface "$WIFI_INTERFACE" daemon --sink "$address" \
    "${mode_args[@]}" --audio \
    >"$DAEMON_LOG" 2>"$DAEMON_ERR_LOG" &
  echo $! >"$DAEMON_PID_FILE"

  # setsid so the tailer leads its own process group, and record that group
  # rather than the subshell's pid. `kill` on the subshell alone left the
  # `tail` inside it orphaned and still running: ten of them had accumulated,
  # one per connect, each replaying the log from the start whenever a new
  # connect truncated it, all writing state at once.
  setsid bash -c '
    tail -n +1 -F "$1" 2>/dev/null | while IFS= read -r line; do
      "$2" __apply-event "$line"
    done
  ' _ "$DAEMON_LOG" "$SELF" &
  echo $! >"$TAILER_PID_FILE"
  disown -a
}

connect_airplay() {
  local peer=$1 address=$2

  stop_scanners

  if ! start_airplay_daemon; then
    update_state '.error = $err' \
      --arg err "AirPlay is unavailable: doubletake is not installed or would not start"
    return 1
  fi

  update_state '
      .error = ""
      | .pending += [$peer + {mode: "mirror", output: "", state: "pairing"}]
    ' --argjson peer "$peer"

  local out
  if ! out=$("$DOUBLETAKE_CTL" connect "$address" 2>&1); then
    local message
    message=$(jq -r '.error // empty' <<<"$out" 2>/dev/null)
    [[ -z $message ]] && message="Could not start the AirPlay stream"
    update_state '
        .error = $err
        | .pending = (.pending | map(select(.address != $addr)))
      ' --arg err "$message" --arg addr "$address"
    return 1
  fi

  # doubletake's connect returns as soon as the stream is queued; the daemon
  # carries it the rest of the way. One sync here so a fast receiver -- the
  # Apple TV takes about two seconds -- shows as connected without waiting for
  # the panel's next poll.
  sleep 2
  sync_airplay
}

# Ends the Miracast session and returns once it is really gone, leaving the
# state file alone. Separate from cmd_disconnect because switching displays
# has to tear the old session down while keeping the discovered list -- a
# full reset there would empty the list the user just clicked in.
stop_miracast_session() {
  if [[ -f $DAEMON_PID_FILE ]]; then
    local pid
    pid=$(cat "$DAEMON_PID_FILE")
    if pid_alive "$pid"; then
      # SIGINT, not SIGTERM/SIGKILL: waycast's run() waits on
      # tokio::signal::ctrl_c() specifically to trigger its own graceful
      # teardown (stop stream, P2P disconnect, remove the headless output,
      # restore xdph.conf). Give that real time before giving up on it.
      kill -INT "$pid" 2>/dev/null
      local waited=0
      while pid_alive "$pid" && (( waited < DISCONNECT_GRACE_SECONDS * 5 )); do
        sleep 0.2
        (( waited++ ))
      done
      # Last resort. Skips waycast's Drop-based cleanup entirely (SIGKILL
      # doesn't unwind) -- see the header comment's known-limitations note.
      pid_alive "$pid" && kill -KILL "$pid" 2>/dev/null
    fi
    rm -f "$DAEMON_PID_FILE"
  fi

  kill_tailer
}

# With an id, ends that one display. Without, ends everything -- which is what
# rescan and a panel-wide "stop" need, and what a user pressing disconnect on
# the last display gets either way.
cmd_disconnect() {
  local display_id=${1:-}

  if [[ -z $display_id ]]; then
    stop_miracast_session
    airplay_daemon_running && "$DOUBLETAKE_CTL" disconnect >/dev/null 2>&1
    update_state '
        .pending = []
        | .connected = []
        | .error = ""
        | .peers = (.peers | map(.state = "available"))
      '
    stop_airplay_daemon
    return 0
  fi

  local protocol address
  protocol=$(protocol_of "$display_id")
  address=$(address_of "$display_id")

  case "$protocol" in
    miracast)
      stop_miracast_session
      update_state '
          .pending = (.pending | map(select(.protocol != "miracast")))
          | .connected = (.connected | map(select(.protocol != "miracast")))
          | .peers = (.peers | map(if .protocol == "miracast" then .state = "available" else . end))
        '
      ;;
    airplay)
      airplay_daemon_running && "$DOUBLETAKE_CTL" disconnect "$address" >/dev/null 2>&1
      sync_airplay
      stop_airplay_daemon
      ;;
    *) echo "unknown protocol '$protocol'" >&2; return 64 ;;
  esac
}

# Discovery, from any state. Unlike scan-start -- which yields to a running
# session so that merely opening the panel cannot kill a working stream --
# this ends every session first, because the user asked for it explicitly and
# the panel has already warned them what it costs.
cmd_rescan() {
  cmd_disconnect
  update_state '$empty' --argjson empty "$EMPTY_STATE"
  cmd_scan_start
}

case "${1:-}" in
  state) cmd_state ;;
  scan-start) cmd_scan_start ;;
  rescan) cmd_rescan ;;
  scan-stop) cmd_scan_stop ;;
  # Internal: the event tailer re-invokes the script per line so each event
  # is folded in under the state lock.
  __apply-event) apply_event "${2:-}" ;;
  connect) cmd_connect "${2:-}" "${3:-mirror}" ;;
  mirror) cmd_connect "${2:-}" mirror ;;
  extend) cmd_connect "${2:-}" extend ;;
  disconnect) cmd_disconnect "${2:-}" ;;
  *)
    cat >&2 <<'USAGE'
usage: omarchy-wireless-display-ctl <command>

  state                     print the panel's state as JSON
  scan-start                begin discovery on every backend
  scan-stop                 end discovery
  rescan                    end every session, clear the list, and scan again
  connect <id> [mode]       connect; mode is "mirror" (default) or "extend".
                            Extend is Miracast only; AirPlay always mirrors.
  mirror <id>               shorthand for: connect <id> mirror
  extend <id>               shorthand for: connect <id> extend
  disconnect [id]           end that display's session, or every session when
                            no id is given

Display ids are namespaced by protocol: "miracast:<mac>", "airplay:<ip>".
USAGE
    exit 64
    ;;
esac
