#!/bin/bash

# omarchy:summary=Control CLI for the Wireless Display panel (Miracast backend: waycast)
# omarchy:group=wireless-display
#
# Real backend, replacing the earlier hand-written stub. Wraps the patched
# waycast fork (../../../.. -> /home/five/Work/alchemy/waycast,
# branch hyprland-support): `waycast discover --json` for scanning, and
# `waycast daemon --json --sink <id> --extend --audio` (a long-lived,
# blocking, single-session process -- see ARCH.md, "Wire both into a
# daemon") launched in the background and tailed for its JSONL event
# stream, which is folded into the same state file the stub used.
#
# Subcommands and the state JSON shape are UNCHANGED from the stub -- see
# ../Model.js -- so Panel.qml needed zero edits for this swap.
#
# Known limitations (see ARCH.md for the full picture):
#   - `waycast daemon --sink X` re-discovers internally before connecting,
#     even though we already know X from our own scan -- waycast has no
#     "connect directly, skip rediscovery" mode. Connect can take a few
#     extra seconds because of this.
#   - waycast reports no signal strength; peers always carry signal=null.
#   - If disconnect has to fall back to SIGKILL (the daemon didn't exit
#     within the grace window), waycast's own Drop-based cleanup (headless
#     output removal, xdph.conf restore) does NOT run -- SIGKILL skips Rust
#     Drop entirely. That would leak a headless output and a stale
#     xdph.conf edit. Not solved here; flagged for whoever picks up
#     lifecycle hardening next.
#   - Only exercised live against the empty-discovery and unknown-peer
#     paths (no real Miracast sink on this network) -- see ARCH.md for
#     what has and hasn't been run against real hardware.

set -uo pipefail

STATE_DIR="${XDG_RUNTIME_DIR:-/tmp}/omarchy-wireless-display"
STATE_FILE="$STATE_DIR/state.json"
DAEMON_PID_FILE="$STATE_DIR/daemon.pid"
TAILER_PID_FILE="$STATE_DIR/tailer.pid"
SCAN_PID_FILE="$STATE_DIR/scan.pid"
DAEMON_LOG="$STATE_DIR/daemon.jsonl"
DAEMON_ERR_LOG="$STATE_DIR/daemon.err"

WAYCAST="${OMARCHY_WIRELESS_DISPLAY_WAYCAST_BIN:-waycast}"
DISCOVER_TIMEOUT="${OMARCHY_WIRELESS_DISPLAY_DISCOVER_TIMEOUT:-8}"
DISCONNECT_GRACE_SECONDS="${OMARCHY_WIRELESS_DISPLAY_DISCONNECT_GRACE_SECONDS:-10}"

# waycast's own --interface default is "wlan0", the old kernel-numbered
# naming; most current systems (predictable network interface naming) use
# something like "wlp0s20f3" instead, so autodetect the real managed Wi-Fi
# interface rather than trust that default. `OMARCHY_WIRELESS_DISPLAY_INTERFACE`
# overrides it outright.
detect_wifi_interface() {
  iw dev 2>/dev/null | awk '/^[[:space:]]*Interface/{iface=$2} /type managed/{print iface; exit}'
}
WIFI_INTERFACE="${OMARCHY_WIRELESS_DISPLAY_INTERFACE:-$(detect_wifi_interface)}"
WIFI_INTERFACE="${WIFI_INTERFACE:-wlan0}"

mkdir -p "$STATE_DIR"

# `connected` is a list because the UI renders one box per connected display.
# In practice it holds at most one: waycast is a single-session process and
# two concurrent sessions contend over ~/.config/hypr/xdph.conf. Keeping it a
# list means the panel needs no rework if that limit is ever lifted.
# `pending` is the display currently being connected -- it carries the mode
# through the event stream, since waycast's events don't echo it back.
EMPTY_STATE='{"status":"idle","error":"","pending":null,"connected":[],"peers":[]}'

STATE_LOCK="$STATE_DIR/state.lock"

# This script re-invokes itself to apply daemon events, so it needs its own
# path rather than relying on being on PATH.
SELF="$(readlink -f "${BASH_SOURCE[0]}")"

read_state() {
  if [[ -f $STATE_FILE ]]; then
    cat "$STATE_FILE"
  else
    printf '%s' "$EMPTY_STATE"
  fi
}

# Atomic: the panel polls this file twice a second, and a plain redirect
# truncates before it writes, so a poll landing in that window reads an empty
# file and parses as the default state -- a connected display flickering out
# of the UI for one frame.
write_state() {
  local tmp="$STATE_FILE.$$"
  printf '%s' "$1" >"$tmp" && mv -f "$tmp" "$STATE_FILE"
}

# Read-modify-write under a lock.
#
# Every mutation goes through here. Without it, concurrent writers each read
# the file, transform their own snapshot and write it back, so whichever
# finishes last silently discards the other's change. That is not theoretical:
# it is what left `status` at "streaming" while `pending` was never moved into
# `connected`, so the panel showed a session it could not offer to disconnect.
#
# jq arguments are passed through, e.g.
#   update_state '.status=$s' --arg s idle
update_state() {
  local program=$1; shift
  local fd
  exec {fd}>>"$STATE_LOCK"
  if flock -w 5 "$fd"; then
    local current updated
    current=$(read_state)
    if updated=$(jq "$@" "$program" <<<"$current" 2>/dev/null) && [[ -n $updated ]]; then
      write_state "$updated"
    else
      echo "state update failed, leaving state untouched: $program" >&2
    fi
  else
    echo "timed out waiting for the state lock; skipping update" >&2
  fi
  exec {fd}>&-
}

pid_alive() {
  [[ -n ${1:-} ]] && kill -0 "$1" 2>/dev/null
}

kill_tracked() {
  local pidfile=$1 signal=${2:-TERM}
  [[ -f $pidfile ]] || return 0
  local pid
  pid=$(cat "$pidfile")
  pid_alive "$pid" && kill "-$signal" "$pid" 2>/dev/null
  rm -f "$pidfile"
}

# The tailer is a process group leader, so signal the whole group -- the
# negative pid -- or the `tail` inside it survives.
kill_tailer() {
  [[ -f $TAILER_PID_FILE ]] || return 0
  local pid
  pid=$(cat "$TAILER_PID_FILE")
  if [[ -n $pid ]]; then
    kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  fi
  rm -f "$TAILER_PID_FILE"
}

# A session owns the state file when one is connected or being connected.
#
# This is the single rule for "is something in progress", derived from the
# same two fields the panel reads. It replaces a `status != idle` test, which
# was a third, subtly different rule: it also refused while status was
# "error", so pressing rescan after a failed connect silently did nothing
# while the panel -- which asks whether anything is connected, not what the
# status string says -- offered the button as available.
session_active() {
  local state=${1:-$(read_state)}
  [[ $(jq -r 'if (.pending != null) or ((.connected | length) > 0) then "yes" else "no" end' \
    <<<"$state") == yes ]]
}

cmd_state() {
  reconcile_dead_session
  read_state
}

# A session whose daemon has died leaves the state claiming a connected
# display forever: SIGKILL skips waycast's teardown, so no "ended" event is
# ever written, and the panel goes on offering a disconnect button for a
# session that no longer exists. Notice and clear it, so the UI recovers by
# itself rather than needing a manual disconnect.
reconcile_dead_session() {
  local state
  state=$(read_state)
  session_active "$state" || return 0

  if [[ -f $DAEMON_PID_FILE ]]; then
    # A live daemon means the state is real, whatever it says.
    pid_alive "$(cat "$DAEMON_PID_FILE")" && return 0
  elif [[ $(jq -r '.pending != null' <<<"$state") == true ]]; then
    # No pid file yet, but a connect is in flight -- cmd_connect writes the
    # pending display before it has a pid to record. Do not race it.
    return 0
  fi

  echo "session's daemon is gone; resetting state" >&2
  kill_tailer
  update_state '$empty | .status="error" | .error=$err' \
    --argjson empty "$EMPTY_STATE" \
    --arg err "The display session ended unexpectedly"
  rm -f "$DAEMON_PID_FILE"
}

cmd_scan_start() {
  # Discovery contends with an active session for the Wi-Fi radio, so it
  # yields to one -- but anything else is a valid moment to look again.
  session_active && return 0

  kill_tracked "$SCAN_PID_FILE" TERM

  # Starting a scan discards what the last one found and any error it left
  # behind. Keeping them meant a rescan showed the previous list, and a
  # previous failure's message, while the new scan was still running -- with
  # nothing to say which was current.
  update_state '.status="discovering" | .error="" | .peers=[] | .pending=null' 

  (
    echo $BASHPID >"$SCAN_PID_FILE"
    result=$("$WAYCAST" --json --interface "$WIFI_INTERFACE" discover --timeout "$DISCOVER_TIMEOUT" 2>/dev/null)
    peers=$(jq -c '[.devices[]? | {
        id: .address,
        name: (.name // .address),
        protocol: "miracast",
        signal: null,
        state: "available"
      }]' <<<"$result" 2>/dev/null)
    [[ -z $peers || $peers == null ]] && peers='[]'

    # Only land results if still discovering -- a connect() or scan-stop
    # in the meantime already owns the state file.
    update_state 'if .status == "discovering" then .status="idle" | .peers=$peers else . end' \
      --argjson peers "$peers"
    rm -f "$SCAN_PID_FILE"
  ) &
  disown
}

cmd_scan_stop() {
  kill_tracked "$SCAN_PID_FILE" TERM
  # Only a discovery session's own results are dropped; a connected display
  # must survive the panel being closed.
  update_state 'if .status == "discovering" then .status="idle" | .peers=[] else . end'
}

# Folds one line of `waycast --json daemon` output (see that fork's
# crates/cli daemon_event_json) into the state file. Anything not
# recognized is ignored rather than erroring -- forward-compatible with
# waycast emitting event kinds this wrapper doesn't know about yet.
apply_event() {
  local line=$1
  local event
  event=$(jq -r '.event // empty' <<<"$line" 2>/dev/null)
  [[ -z $event ]] && return 0

  case "$event" in
    started)
      update_state '.status="pairing"'
      ;;
    connected)
      update_state '.status="negotiating"'
      ;;
    virtual_output_created)
      local output_name
      output_name=$(jq -r '.name // empty' <<<"$line")
      # Mirroring creates no virtual output, so this never fires for it and
      # the display's `output` stays empty -- which is correct, not missing.
      [[ -n $output_name ]] && update_state \
        'if .pending then .pending.output=$out else . end' --arg out "$output_name"
      ;;
    negotiated)
      update_state '.status="negotiating"'
      ;;
    streaming_started)
      # The in-flight display becomes a connected one. Its mode came from the
      # connect call, not from waycast, which is why we carried it here.
      update_state '
          if .pending then
            (.pending.id) as $pid
            | .connected += [.pending]
            | .peers = (.peers | map(if .id == $pid then .state = "connected" else . end))
            | .pending = null
          else . end
          | .status = "streaming"
        '
      ;;
    error)
      local message
      message=$(jq -r '.message // "Connection failed"' <<<"$line")
      update_state '.status="error" | .error=$err | .pending=null' --arg err "$message"
      ;;
    ended)
      # A prior "error" event already told the story; don't clobber it with a
      # bare idle reset once the (now-exiting) daemon process catches up.
      update_state 'if .status == "error" then . else $empty end' \
        --argjson empty "$EMPTY_STATE"
      rm -f "$DAEMON_PID_FILE"
      ;;
  esac
}

cmd_connect() {
  local peer_id=${1:?peer id required}
  local mode=${2:-extend}

  case "$mode" in
    extend|mirror) ;;
    *) echo "unknown mode '$mode' (expected 'extend' or 'mirror')" >&2; return 64 ;;
  esac

  local current peer
  current=$(read_state)
  peer=$(jq --arg id "$peer_id" '[.peers[] | select(.id == $id)][0]' <<<"$current")
  if [[ $peer == null ]]; then
    update_state '.status="error" | .error=$err' --arg err "Unknown peer $peer_id"
    return 1
  fi

  # Still one session at a time -- waycast holds the Wi-Fi P2P interface
  # and, in extend mode, an edit to xdph.conf, so two would fight over both.
  # But pairing with a different display is a switch, not an error: end the
  # current session first and carry on. The peer was captured above, before
  # the teardown, precisely so the discovered list can be preserved across
  # it; looking it up afterwards would find nothing.
  if session_active "$current"; then
    local previous
    previous=$(jq -r '[.connected[].name // .connected[].id] | join(", ")' <<<"$current")
    [[ -n $previous ]] && echo "switching away from $previous" >&2
    stop_session
    update_state '
        .connected = []
        | .pending = null
        | .error = ""
        | .peers = (.peers | map(.state = "available"))
      '
  fi

  cmd_scan_stop

  update_state '.status="pairing" | .error="" | .pending=($peer + {mode: $mode, output: ""})' \
    --argjson peer "$peer" --arg mode "$mode"

  # --extend creates a headless output and streams that. Without it waycast
  # mirrors an existing output, which it picks through the desktop portal --
  # so mirroring shows the portal's screen-share dialog, because nothing
  # arms waycast's one-shot picker override outside extend mode.
  local -a mode_args=()
  [[ $mode == extend ]] && mode_args+=(--extend)

  # Belt and braces against the leak above having happened before this fix,
  # or any tailer that outlived its process group.
  kill_tailer
  pkill -f "tail -n \\+1 -F $DAEMON_LOG" 2>/dev/null || true

  : >"$DAEMON_LOG"
  : >"$DAEMON_ERR_LOG"
  setsid "$WAYCAST" --json --interface "$WIFI_INTERFACE" daemon --sink "$peer_id" \
    "${mode_args[@]}" --audio \
    >"$DAEMON_LOG" 2>"$DAEMON_ERR_LOG" &
  echo $! >"$DAEMON_PID_FILE"

  # setsid so the tailer leads its own process group, and record that group
  # rather than the subshell's pid. `kill` on the subshell alone left the
  # `tail` inside it orphaned and still running: ten of them had accumulated,
  # one per connect, each replaying the log from the start whenever a new
  # connect truncated it, all writing state at once.
  setsid bash -c '
    tail -n +1 -F "$1" 2>/dev/null | while IFS= read -r line; do
      "$2" __apply-event "$line"
    done
  ' _ "$DAEMON_LOG" "$SELF" &
  echo $! >"$TAILER_PID_FILE"
  disown -a
}

# Ends the running session and returns once it is really gone, leaving the
# state file alone. Separate from cmd_disconnect because switching displays
# has to tear the old session down while keeping the discovered list -- a
# full reset there would empty the list the user just clicked in.
stop_session() {
  if [[ -f $DAEMON_PID_FILE ]]; then
    local pid
    pid=$(cat "$DAEMON_PID_FILE")
    if pid_alive "$pid"; then
      # SIGINT, not SIGTERM/SIGKILL: waycast's run() waits on
      # tokio::signal::ctrl_c() specifically to trigger its own graceful
      # teardown (stop stream, P2P disconnect, remove the headless output,
      # restore xdph.conf). Give that real time before giving up on it.
      kill -INT "$pid" 2>/dev/null
      local waited=0
      while pid_alive "$pid" && (( waited < DISCONNECT_GRACE_SECONDS * 5 )); do
        sleep 0.2
        (( waited++ ))
      done
      # Last resort. Skips waycast's Drop-based cleanup entirely (SIGKILL
      # doesn't unwind) -- see the header comment's known-limitations note.
      pid_alive "$pid" && kill -KILL "$pid" 2>/dev/null
    fi
    rm -f "$DAEMON_PID_FILE"
  fi

  kill_tailer
}

# Takes an optional display id. There is only ever one session, so it is
# accepted and ignored rather than being a lie in the UI's call.
cmd_disconnect() {
  local _id=${1:-}
  stop_session
  update_state '$empty' --argjson empty "$EMPTY_STATE"
}

# Discovery, from any state. Unlike scan-start -- which yields to a running
# session so that merely opening the panel cannot kill a working stream --
# this ends the session first, because the user asked for it explicitly and
# the panel has already warned them what it costs.
cmd_rescan() {
  stop_session
  update_state '$empty' --argjson empty "$EMPTY_STATE"
  cmd_scan_start
}

case "${1:-}" in
  state) cmd_state ;;
  scan-start) cmd_scan_start ;;
  rescan) cmd_rescan ;;
  scan-stop) cmd_scan_stop ;;
  # Internal: the event tailer re-invokes the script per line so each event
  # is folded in under the state lock.
  __apply-event) apply_event "${2:-}" ;;
  connect) cmd_connect "${2:-}" "${3:-extend}" ;;
  mirror) cmd_connect "${2:-}" mirror ;;
  extend) cmd_connect "${2:-}" extend ;;
  disconnect) cmd_disconnect "${2:-}" ;;
  *)
    cat >&2 <<'USAGE'
usage: omarchy-wireless-display-ctl <command>

  state                     print the panel's state as JSON
  scan-start                begin discovery
  scan-stop                 end discovery
  rescan                    end any session, clear the list, and scan again
  connect <id> [mode]       connect; mode is "extend" (default) or "mirror"
  mirror <id>               shorthand for: connect <id> mirror
  extend <id>               shorthand for: connect <id> extend
  disconnect [id]           end the session (id accepted, currently unused --
                            only one session can be active at a time)
USAGE
    exit 64
    ;;
esac
